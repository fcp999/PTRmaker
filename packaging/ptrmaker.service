[Unit]
Description=PTRmaker learning DNS forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ptrmaker
Group=ptrmaker
EnvironmentFile=-/etc/ptrmaker/ptrmaker.env
ExecStart=/usr/local/bin/ptrmaker $PTRMAKER_ARGS
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ptrmaker
StateDirectory=ptrmaker

[Install]
WantedBy=multi-user.target
